    "@tauri-apps/plugin-dialog": "^2.7.1",
    "b4a": "^1.8.1",
    "bare-buffer": "^3.6.0",
    "bare-fs": "^4.7.1",
    "bare-os": "^3.9.1",
    "bare-path": "^3.0.0",
    "bare-process": "^4.4.1",
    "bare-rpc": "^1.3.2",
    "bare-url": "^2.4.3",
    "compact-encoding": "^3.1.0",
    "deepsignal": "^1.6.0",
    "expo": "~56.0.8",
    "expo-constants": "^56.0.16",
    "expo-linking": "~56.0.13",
    "expo-router": "~56.2.8",
    "react": "19.2.3",
