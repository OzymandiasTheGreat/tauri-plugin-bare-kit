  },
  "license": "Apache-2.0",
  "description": "An example P2P chat app powered by Tauri and Bare",
  "repository": "https://github.com/OzymandiasTheGreat/tauri-plugin-bare-kit/tree/main/example",
  "main": "expo-router/entry",
  "scripts": {
    "start": "npm run start:bare & npm run start:expo",
    "start:bare": "tsc -w -p src-bare",
    "start:expo": "watchman watch-del .. && expo start --clear",
    "build": "npm run build:bare && npm run build:expo",
    "build:bare": "tsc -p src-bare",
    "build:expo": "expo export --platform web",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@hyperswarm/rpc": "^3.5.0",
    "@preact/signals-react": "^3.10.1",
    "@react-native-vector-icons/material-design-icons": "^13.1.2",
