{
  "private": true,
  "name": "bare-messenger",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "npm run start:bare & npm run start:expo",
    "start:bare": "tsc -w -p src-bare",
    "start:expo": "watchman watch-del .. && expo start --clear",
    "build": "npm run build:bare && npm run build:expo",
    "build:bare": "tsc -p src-bare",
    "build:expo": "expo export --platform web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@preact/signals-react": "^3.6.1",
    "@react-navigation/native": "^7.1.8",
    "@tauri-apps/api": "^2.9.1",
    "b4a": "^1.7.3",
    "bare-rpc": "^1.0.0",
    "compact-encoding": "^2.18.0",
    "dns-discovery": "^6.2.3",
    "expo": "~54.0.27",
    "expo-linking": "~8.0.10",
    "expo-router": "~6.0.17",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "sodium-native": "^5.0.10",
    "tauri-plugin-bare-kit-api": "file:../",
    "z32": "^1.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.6",
    "@types/compact-encoding": "^2.15.0",
    "@types/react": "~19.1.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  }
}
