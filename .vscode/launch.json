{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Unit Tests Development",
      "cargo": {
        "args": [
          "test",
          "--features",
          "tests"
        ]
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Unit Tests Production",
      "cargo": {
        "args": [
          "test",
          "--release",
          "--features",
          "tests"
        ]
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "E2E Tests Development",
      "cargo": {
        "args": [
          "build",
          "--manifest-path=./tests/src-tauri/Cargo.toml",
          "--target-dir=./target",
          "--no-default-features"
        ]
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "E2E Tests Production",
      "cargo": {
        "args": [
          "build",
          "--release",
          "--manifest-path=./tests/src-tauri/Cargo.toml",
          "--target-dir=./target"
        ]
      }
    }
  ]
}
